# ============================================================
# Automation 環境變數模板
# 複製此檔案為 .env 並填入實際值
# ============================================================

# ── 飛書配置（必需）──
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_DEFAULT_CHAT_ID=your_default_chat_id_here
FEISHU_USER_OPEN_ID=your_user_open_id_here

# ── 微信配置（必需）──
WECHAT_PUSH_TO_USER=your_wechat_user_id_here
# WECHAT_PUSH_CONTEXT_TOKEN=optional_context_token

# ── Claude API（必需）──
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── 資料源（必需）──
FINMIND_TOKEN=your_finmind_token_here

# ── 微信 Bridge 配置（可選）──
# WECHAT_BRIDGE_ENABLE_POLLING=1
# WECHAT_CONTEXT_MAX_AGE_HOURS=8
# WECHAT_SEND_MAX_LENGTH=2000
# WECHAT_SEND_CHUNK_DELAY_MS=900
# WECHAT_KEEPALIVE_INTERVAL_MS=14400000     # 自 ping 間隔，預設 4 小時
# WECHAT_KEEPALIVE_MIN_AGE_MS=10800000      # 自 ping 觸發 age 門檻，預設 3 小時
# WECHAT_INVALID_ALERT_COOLDOWN_MS=1800000  # invalid 告警去重，預設 30 分鐘

# ── Python 執行檔（自動偵測）──
# PYTHON_BIN=/usr/bin/python3
