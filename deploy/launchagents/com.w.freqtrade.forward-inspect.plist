<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w.freqtrade.forward-inspect</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/w/freqtrade-lab/venv/bin/python</string>
		<string>/Users/w/freqtrade-lab/forward_inspect.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/w/freqtrade-lab</string>
