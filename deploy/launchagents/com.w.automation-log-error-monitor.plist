<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w.automation-log-error-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/w/.homebrew/bin/python3</string>
		<string>scripts/log_error_monitor.py</string>
		<string>--once</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/w/Cursor/automation</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/w/.homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONPATH</key>
		<string>/Users/w/Cursor/automation</string>
	</dict>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/w/Cursor/automation/logs/log-error-monitor.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/w/Cursor/automation/logs/log-error-monitor.err.log</string>
</dict>
</plist>
