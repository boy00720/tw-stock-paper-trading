<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w.claude-nvidia-backup-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/w/.local/bin/start-claude-nvidia-backup-proxy</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/w/Library/Logs/claude-nvidia-backup-proxy.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/w/Library/Logs/claude-nvidia-backup-proxy.log</string>
</dict>
</plist>
